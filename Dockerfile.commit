# Build the devpilot-commit streaming image builder
# Override BASE_IMAGE to build from another registry, e.g. docker.io/library/golang:1.26
ARG BASE_IMAGE=golang:1.26
FROM ${BASE_IMAGE} AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY . .

# CGO must stay off: the binary runs on cluster nodes where it only needs the
# kernel and the network, and a static binary keeps the image free of a libc.
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
	go build -a -trimpath -ldflags="-s -w" -o devpilot-commit ./cmd/devpilot-commit

# distroless/static carries no shell and no package manager, so pulling it
# cannot execute an installer and a scanner sees nothing installed. The build
# job runs this image non-root with every capability dropped.
FROM gcr.io/distroless/static:nonroot
COPY --from=builder /workspace/devpilot-commit /devpilot-commit
USER 65532:65532
ENTRYPOINT ["/devpilot-commit"]
